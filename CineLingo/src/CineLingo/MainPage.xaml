<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CineLingo.PageModels"
             xmlns:models="clr-namespace:CineLingo.Models"
             x:DataType="pageModels:MainPageModel"
             x:Class="CineLingo.MainPage" BackgroundColor="Black"
             Title="CineLingo">
    <!-- Three-row grid: status bar (auto) / captions (*) / bottom panel (auto) -->
    <Grid VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status bar: shows current mode (detecting / English diarization / multi-language) -->
        <Label Grid.Row="0" Margin="12,4,12,0"
               Text="{Binding StatusMessage}"
               TextColor="#666666" FontSize="11"
               IsVisible="{Binding HasStatusMessage}"/>

        <!-- Finalized captions list -->
        <CollectionView x:Name="CaptionsView"
                        Grid.Row="1"
                        ItemsSource="{Binding Captions}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Caption">
                    <VerticalStackLayout Margin="12,4">
                        <!-- Speaker label shown only in English/diarization mode -->
                        <Label Text="{Binding SpeakerLabel}"
                               TextColor="#888888" FontSize="11" FontAttributes="Bold"
                               IsVisible="{Binding HasSpeakerLabel}"/>
                        <Label Text="{Binding Text}" LineBreakMode="WordWrap"
                               TextColor="{Binding TextColor}" FontSize="18"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom panel: partial caption + buttons.
             SizeChanged re-scrolls the CollectionView when the panel grows. -->
        <VerticalStackLayout x:Name="BottomPanel"
                             Grid.Row="2"
                             BackgroundColor="Black"
                             SizeChanged="OnBottomPanelSizeChanged">

            <!-- Interim/partial caption — always occupies at least one line of space -->
            <Label Margin="12,4" Text="{Binding PartialCaption}"
                   LineBreakMode="WordWrap" TextColor="#888888" FontAttributes="Italic" FontSize="18"
                   MinimumHeightRequest="28"/>

            <!-- Start / Stop toggle -->
            <Button Text="Start Captions"
                    IsEnabled="{Binding IsStartEnabled}" IsVisible="{Binding IsStartEnabled}"
                    HorizontalOptions="Fill" BackgroundColor="#512BD4" TextColor="White"
                    Command="{Binding StartTranscriptionCommand}"/>
            <Button Text="Stop Captions"
                    IsEnabled="{Binding IsStopEnabled}" IsVisible="{Binding IsStopEnabled}"
                    HorizontalOptions="Fill" BackgroundColor="#3a1f9e" TextColor="White"
                    Command="{Binding StopTranscriptionCommand}"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>

