<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CineLingo.PageModels"
             xmlns:models="clr-namespace:CineLingo.Models"
             x:DataType="pageModels:MainPageModel"
             x:Class="CineLingo.MainPage" BackgroundColor="Black">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <!-- Two-row grid: captions fill remaining height / bottom panel auto-sizes -->
    <Grid VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Finalized captions list -->
        <CollectionView x:Name="CaptionsView"
                        Grid.Row="0"
                        ItemsSource="{Binding Captions}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Caption">
                    <VerticalStackLayout Margin="12,4">
                        <!-- Speaker label (diarization mode only) -->
                        <Label Text="{Binding SpeakerLabel}"
                               TextColor="#888888" FontSize="11" FontAttributes="Bold"
                               IsVisible="{Binding HasSpeakerLabel}"/>
                        <!-- Primary text: translated when available, original otherwise -->
                        <Label Text="{Binding DisplayText}" LineBreakMode="WordWrap"
                               TextColor="{Binding TextColor}" FontSize="{DynamicResource CaptionFontSize}"/>
                        <!-- Original text shown as subtitle once translation arrives -->
                        <Label Text="{Binding Text}" LineBreakMode="WordWrap"
                               TextColor="#555555" FontSize="13"
                               IsVisible="{Binding HasTranslation}"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom panel: partial caption + fixed-height toolbar.
             SizeChanged re-scrolls CollectionView when partial caption wraps. -->
        <VerticalStackLayout x:Name="BottomPanel"
                             Grid.Row="1"
                             BackgroundColor="Black"
                             Padding="0,4,0,0"
                             SizeChanged="OnBottomPanelSizeChanged">

            <!-- Interim/partial caption — always reserves at least one line of height -->
            <Label Margin="12,0,12,4" Text="{Binding PartialCaption}"
                   LineBreakMode="WordWrap" TextColor="#888888" FontAttributes="Italic" FontSize="18"
                   MinimumHeightRequest="28"/>

            <!-- Toolbar: 5-column structure — layout never shifts -->
            <Grid Padding="8,0,8,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- App identity -->
                    <ColumnDefinition Width="Auto"/>  <!-- Translation toggle -->
                    <ColumnDefinition Width="Auto"/>  <!-- Settings -->
                    <ColumnDefinition Width="*"/>     <!-- Button + status overlay -->
                    <ColumnDefinition Width="Auto"/>  <!-- Listening dot -->
                </Grid.ColumnDefinitions>

                <!-- App identity: placeholder badge + name -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Border WidthRequest="36" HeightRequest="36"
                            BackgroundColor="#512BD4"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="CL" TextColor="White" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="CineLingo" FontSize="9" TextColor="#666666" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Translation toggle: globe icon, dimmed when disabled -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"
                                     Opacity="{Binding TranslationOpacity}">
                    <Border WidthRequest="36" HeightRequest="36"
                            BackgroundColor="#1E1E1E"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleTranslationCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="🌐" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Translate" FontSize="9" TextColor="#666666" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Settings button -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Border WidthRequest="36" HeightRequest="36"
                            BackgroundColor="#1E1E1E"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="⚙️" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Settings" FontSize="9" TextColor="#666666" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Button column: Start/Stop button with status text overlaid at bottom-right -->
                <Grid Grid.Column="3">
                    <Button Text="Start Captions"
                            IsEnabled="{Binding IsStartEnabled}" IsVisible="{Binding IsStartEnabled}"
                            HorizontalOptions="Fill" CornerRadius="8"
                            BackgroundColor="#512BD4" TextColor="White"
                            Command="{Binding StartTranscriptionCommand}"/>
                    <Button Text="Stop Captions"
                            IsEnabled="{Binding IsStopEnabled}" IsVisible="{Binding IsStopEnabled}"
                            HorizontalOptions="Fill" CornerRadius="8"
                            BackgroundColor="#3a1f9e" TextColor="White"
                            Command="{Binding StopTranscriptionCommand}"/>
                    <Label Text="{Binding StatusMessage}"
                           TextColor="White" FontSize="9" Opacity="0.6"
                           VerticalOptions="End" HorizontalOptions="End"
                           Margin="0,0,10,4"
                           InputTransparent="True"/>
                </Grid>

                <!-- Listening dot: pulsing animation, visible only while recogniser is running -->
                <VerticalStackLayout Grid.Column="4"
                                     IsVisible="{Binding IsStopEnabled}"
                                     VerticalOptions="Center" Padding="4,0" MinimumWidthRequest="44">
                    <Label x:Name="ListeningDot" Text="⬤" FontSize="22"
                           TextColor="#7C5CBF" HorizontalOptions="Center"/>
                    <Label Text="Listening" FontSize="9"
                           TextColor="#888888" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

