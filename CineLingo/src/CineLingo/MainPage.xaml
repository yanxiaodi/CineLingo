<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CineLingo.PageModels"
             xmlns:models="clr-namespace:CineLingo.Models"
             x:DataType="pageModels:MainPageModel"
             x:Class="CineLingo.MainPage" BackgroundColor="Black">

    <!-- Hide the Shell navigation bar — the app title wastes vertical space -->
    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <!-- Two-row grid: captions fill remaining height / bottom panel auto-sizes -->
    <Grid VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Finalized captions list -->
        <CollectionView x:Name="CaptionsView"
                        Grid.Row="0"
                        ItemsSource="{Binding Captions}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Caption">
                    <VerticalStackLayout Margin="12,4">
                        <!-- Speaker label shown only in English/diarization mode -->
                        <Label Text="{Binding SpeakerLabel}"
                               TextColor="#888888" FontSize="11" FontAttributes="Bold"
                               IsVisible="{Binding HasSpeakerLabel}"/>
                        <Label Text="{Binding Text}" LineBreakMode="WordWrap"
                               TextColor="{Binding TextColor}" FontSize="18"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom panel: partial caption + button row + status.
             SizeChanged re-scrolls the CollectionView when height changes. -->
        <VerticalStackLayout x:Name="BottomPanel"
                             Grid.Row="1"
                             BackgroundColor="Black"
                             Padding="0,4,0,0"
                             SizeChanged="OnBottomPanelSizeChanged">

            <!-- Interim/partial caption — always occupies at least one line of space -->
            <Label Margin="12,0,12,4" Text="{Binding PartialCaption}"
                   LineBreakMode="WordWrap" TextColor="#888888" FontAttributes="Italic" FontSize="18"
                   MinimumHeightRequest="28"/>

            <!-- Button row: [Start or Stop button | Listening animation] -->
            <Grid ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Text="Start Captions"
                        IsEnabled="{Binding IsStartEnabled}" IsVisible="{Binding IsStartEnabled}"
                        HorizontalOptions="Fill" BackgroundColor="#512BD4" TextColor="White"
                        Command="{Binding StartTranscriptionCommand}"/>
                <Button Grid.Column="0" Text="Stop Captions"
                        IsEnabled="{Binding IsStopEnabled}" IsVisible="{Binding IsStopEnabled}"
                        HorizontalOptions="Fill" BackgroundColor="#3a1f9e" TextColor="White"
                        Command="{Binding StopTranscriptionCommand}"/>

                <!-- Pulsing dot animation — visible only while listening -->
                <VerticalStackLayout Grid.Column="1"
                                     Padding="16,0" VerticalOptions="Center"
                                     IsVisible="{Binding IsStopEnabled}">
                    <Label x:Name="ListeningDot" Text="⬤" FontSize="22"
                           TextColor="#7C5CBF" HorizontalOptions="Center"/>
                    <Label Text="Listening" FontSize="9"
                           TextColor="#888888" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Language/mode status: shown below buttons while recogniser is running -->
            <Label Margin="12,2,12,4"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   TextColor="#555555" FontSize="11"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>

