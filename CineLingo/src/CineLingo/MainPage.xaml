<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CineLingo.PageModels"
             xmlns:models="clr-namespace:CineLingo.Models"
             x:DataType="pageModels:MainPageModel"
             x:Class="CineLingo.MainPage" BackgroundColor="Black"
             Title="CineLingo">
    <Grid VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Finalized captions list — auto-scrolls to newest item -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Captions}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Caption">
                    <Label Margin="12,4" Text="{Binding Text}" LineBreakMode="WordWrap"
                           TextColor="{Binding TextColor}" FontSize="18"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Interim/partial caption — always occupies space to prevent CollectionView from jumping -->
        <Label Grid.Row="1" Margin="12,4" Text="{Binding PartialCaption}"
               LineBreakMode="WordWrap" TextColor="#888888" FontAttributes="Italic" FontSize="18"
               MinimumHeightRequest="28"/>

        <!-- Start / Stop toggle -->
        <Button Grid.Row="2" Text="Start Captions"
                IsEnabled="{Binding IsStartEnabled}" IsVisible="{Binding IsStartEnabled}"
                HorizontalOptions="Fill" BackgroundColor="#512BD4" TextColor="White"
                Command="{Binding StartTranscriptionCommand}"/>
        <Button Grid.Row="2" Text="Stop Captions"
                IsEnabled="{Binding IsStopEnabled}" IsVisible="{Binding IsStopEnabled}"
                HorizontalOptions="Fill" BackgroundColor="#3a1f9e" TextColor="White"
                Command="{Binding StopTranscriptionCommand}"/>
    </Grid>
</ContentPage>

